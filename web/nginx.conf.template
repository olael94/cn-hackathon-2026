server {
    listen 8080;
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
    root /usr/share/nginx/html;

    location = /healthz { return 200 "ok\n"; }
    location = /readyz { return 200 "ok\n"; }

    location /api/ {
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE: pass events through as they arrive and keep long streams open.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;

        # Audio chunks are small, but leave room above the 1 MB default.
        client_max_body_size 10m;
    }

    location / {
        try_files $uri /index.html;
    }
}
