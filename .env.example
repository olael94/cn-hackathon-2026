# Copy to .env and fill in real values. Never commit .env.

# OpenAI ($50 hackathon credits)
OPENAI_API_KEY=
THEMES_LABEL_MODEL=

# Shared secret between the backend and translator Deployment
TRANSLATOR_TOKEN=

# Elasticsearch (Elastic Cloud serverless project home: "Connect to your project")
ES_URL=https://<project>.es.us-west-2.aws.elastic.cloud
ES_API_KEY=
# Multilingual embeddings for semantic_text (optional, this is the default in search.py)
ES_INFERENCE_ID=.jina-embeddings-v3

# Dash0 / OpenTelemetry export
# Endpoint and token come from Dash0: Settings > Endpoints and Settings > Auth Tokens
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingress.us-west-2.aws.dash0.com:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
DASH0_AUTH_TOKEN=
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer%20${DASH0_AUTH_TOKEN}"
OTEL_SERVICE_NAME=cnh-backend
DASH0_DATASET=default
