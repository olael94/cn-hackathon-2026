{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Segment",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "talk_id": { "type": "string" },
    "seq": { "type": "integer", "minimum": 0 },
    "t_start": { "type": "number" },
    "t_end": { "type": "number" },
    "captured_at": { "type": ["string", "null"], "format": "date-time" },
    "text_en": { "type": "string" },
    "text_es": { "type": ["string", "null"] },
    "emitted_at": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "talk_id", "seq", "t_start", "t_end", "text_en", "text_es", "emitted_at"],
  "additionalProperties": false
}
