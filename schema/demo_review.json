{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DemoReview",
  "type": "object",
  "properties": {
    "target": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "segment": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "replay",
        "elasticsearch"
      ],
      "default": "replay"
    },
    "score": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "suggestion": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "support",
            "expand",
            "ask"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [],
  "additionalProperties": false
}
