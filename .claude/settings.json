{
  "permissions": {
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh pr create *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "dash0@claude-plugins-official": true,
    "sonarqube@claude-plugins-official": true,
    "vercel@claude-plugins-official": false,
    "deploy-on-aws@claude-plugins-official": false
  }
}
