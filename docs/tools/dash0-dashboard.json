{
  "apiVersion": "perses.dev/v1alpha1",
  "kind": "PersesDashboard",
  "metadata": {
    "name": "roompass-pipeline"
  },
  "spec": {
    "display": {
      "name": "RoomPass: caption lag and pipeline",
      "description": "Caption lag from the phones against the 10 s SLO, and the backend spans behind it."
    },
    "duration": "30m",
    "refreshInterval": "15s",
    "panels": {
      "caption_lag": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Caption lag on phones (p50, p95, SLO 10 s)",
            "description": "From the roompass.caption.lag web event, turned into a histogram by a SignalControl rule."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": { "position": "bottom" },
              "yAxis": { "format": { "unit": "seconds" } }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum(rate({otel_metric_name=\"roompass.caption.lag\"}[1m])))",
                    "seriesNameFormat": "p95"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.5, sum(rate({otel_metric_name=\"roompass.caption.lag\"}[1m])))",
                    "seriesNameFormat": "p50"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "vector(10)",
                    "seriesNameFormat": "SLO 10 s"
                  }
                }
              }
            }
          ]
        }
      },
      "pipeline_p95": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Pipeline span duration p95",
            "description": "pipeline.transcribe, pipeline.translate, pipeline.index, pipeline.publish"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": { "position": "bottom" },
              "yAxis": { "format": { "unit": "seconds" } }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum by (otel_span_name) (rate({otel_metric_name=\"dash0.spans.duration\", otel_span_name=~\"pipeline.transcribe|pipeline.translate|pipeline.index|pipeline.publish\"}[1m])))",
                    "seriesNameFormat": "{{otel_span_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "questions_themes_p95": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "questions.check and themes.build duration p95"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": { "position": "bottom" },
              "yAxis": { "format": { "unit": "seconds" } }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum by (otel_span_name) (rate({otel_metric_name=\"dash0.spans.duration\", otel_span_name=~\"questions.check|themes.build\"}[5m])))",
                    "seriesNameFormat": "{{otel_span_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "span_error_rate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Error rate per span",
            "description": "Share of spans with status ERROR."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": { "position": "bottom" },
              "yAxis": { "format": { "unit": "percent-decimal" } }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(sum by (otel_span_name) (rate({otel_metric_name=\"dash0.spans\", otel_span_status_code=\"ERROR\", otel_span_name=~\"pipeline.transcribe|pipeline.translate|pipeline.index|pipeline.publish|questions.check|themes.build\"}[5m])) or 0 * sum by (otel_span_name) (rate({otel_metric_name=\"dash0.spans\", otel_span_name=~\"pipeline.transcribe|pipeline.translate|pipeline.index|pipeline.publish|questions.check|themes.build\"}[5m]))) / sum by (otel_span_name) (rate({otel_metric_name=\"dash0.spans\", otel_span_name=~\"pipeline.transcribe|pipeline.translate|pipeline.index|pipeline.publish|questions.check|themes.build\"}[5m]))",
                    "seriesNameFormat": "{{otel_span_name}}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            { "x": 0, "y": 0, "width": 24, "height": 8, "content": { "$ref": "#/spec/panels/caption_lag" } },
            { "x": 0, "y": 8, "width": 12, "height": 8, "content": { "$ref": "#/spec/panels/pipeline_p95" } },
            { "x": 12, "y": 8, "width": 12, "height": 8, "content": { "$ref": "#/spec/panels/questions_themes_p95" } },
            { "x": 0, "y": 16, "width": 24, "height": 8, "content": { "$ref": "#/spec/panels/span_error_rate" } }
          ]
        }
      }
    ]
  }
}
